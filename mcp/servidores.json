{
    "painel-dokku":  {
                         "type":  "http",
                         "url":  "https://deploy.geniai.online/mcp",
                         "headers":  {
                                         "Authorization":  "Bearer {{MCP_PAINEL_DOKKU_AUTHORIZATION}}"
                                     }
                     },
    "testsprite":  {
                       "type":  "stdio",
                       "command":  "npx",
                       "args":  [
                                    "-y",
                                    "@testsprite/testsprite-mcp@latest"
                                ],
                       "env":  {
                                   "API_KEY":  "{{MCP_TESTSPRITE_API_KEY}}"
                               }
                   }
}